{
  "team": {
    "name": "codenotary",
    "version": "0.5.0",
    "description": "CodeNotary (代码公证处) — trustworthy delivery pipeline for AI-generated code, on AgentTeams.",
    "primary_runtime": "agentteams-real-llm",
    "worker_runtime": "qwenpow(copow/QwenPaw)",
    "creation_policy": {
      "mode": "serial",
      "order": ["sentinel", "triage", "rca", "contract", "author", "tester", "convention", "gatekeeper", "release", "postmortem", "team"],
      "rule": "Create the next business Worker only after the previous Worker is created and verified healthy. During Team creation, manager must create codenotary-leader as a dedicated TeamLeader Worker."
    },
    "team_leader": {
      "id": "codenotary_leader",
      "name": "codenotary-leader",
      "creation": "created by manager during Team creation",
      "rule": "Must be created as a new independent Worker and designated as TeamLeader. Do not designate any business Worker as leader."
    },
    "agent_spec_source": "inline messages in at/create_agents_messages.md",
    "task_source": "two separate notarization task messages in at/run_demo_task_message.md",
    "task_submission_policy": {
      "room": "Matrix room whose name starts with Team and matches codenotary",
      "mention": "@<team_leader_name>",
      "rule": "Enter the Team room, mention the team leader, paste one notarization task into that mention message, and wait for the notary report before submitting the next task."
    },
    "tool_gateway": {
      "transport": "http",
      "base_url": "http://<TOOL_HOST_REACHABLE_BY_WORKER>:18090",
      "call_pattern": "POST /tools/{scenario_id}/{tool_name}.{function_name}"
    },
    "core_invariant": "LLM output never drives state transitions. Gate scores, red/yellow/green verdicts and pipeline state transitions are computed by the gateway's deterministic code only."
  },
  "agents": [
    {
      "id": "sentinel",
      "name": "Sentinel Agent",
      "local_spec_file": "agents/sentinel/Agent.md",
      "skills": ["input-validation-injection", "ai-hallucination-guard"],
      "tools": ["notary_change", "notary_sentinel"]
    },
    {
      "id": "triage",
      "name": "Triage Agent",
      "local_spec_file": "agents/triage/Agent.md",
      "skills": [],
      "tools": ["notary_change", "notary_flow"]
    },
    {
      "id": "rca",
      "name": "RCA Agent",
      "local_spec_file": "agents/rca/Agent.md",
      "skills": ["boundary-condition-check", "flaky-test-isolation"],
      "tools": ["notary_repo", "notary_flow"]
    },
    {
      "id": "contract",
      "name": "Contract Agent",
      "local_spec_file": "agents/contract/Agent.md",
      "skills": ["requirement-ambiguity-scan", "backward-compatibility-check"],
      "tools": ["notary_change", "notary_contract"]
    },
    {
      "id": "author",
      "name": "Author Agent",
      "local_spec_file": "agents/author/Agent.md",
      "skills": ["ai-hallucination-guard", "boundary-condition-check", "exception-handling-convention"],
      "tools": ["notary_author", "notary_rebuttal"]
    },
    {
      "id": "tester",
      "name": "Tester Agent",
      "local_spec_file": "agents/tester/Agent.md",
      "skills": ["boundary-condition-check", "flaky-test-isolation"],
      "tools": ["notary_tester"]
    },
    {
      "id": "convention",
      "name": "Convention Agent",
      "local_spec_file": "agents/convention/Agent.md",
      "skills": ["diff-scope-discipline", "backward-compatibility-check", "exception-handling-convention", "input-validation-injection"],
      "tools": ["notary_gate"]
    },
    {
      "id": "gatekeeper",
      "name": "Gatekeeper Agent",
      "local_spec_file": "agents/gatekeeper/Agent.md",
      "skills": [],
      "tools": ["notary_verdicts", "notary_state"]
    },
    {
      "id": "release",
      "name": "Release Agent",
      "local_spec_file": "agents/release/Agent.md",
      "skills": [],
      "tools": ["notary_state", "notary_release"]
    },
    {
      "id": "postmortem",
      "name": "Postmortem Agent",
      "local_spec_file": "agents/postmortem/Agent.md",
      "skills": ["(distills new skills; compares against all seed skills before registering)"],
      "tools": ["notary_evidence", "notary_skill"]
    }
  ],
  "workflow": [
    {"step": 1, "agent": "codenotary_leader", "task": "receive_notarization_task_and_dispatch"},
    {"step": 2, "agent": "sentinel", "task": "quarantine_scan"},
    {"step": 3, "agent": "triage", "task": "accept_reject_escalate"},
    {"step": 4, "agent": "rca", "task": "diagnose_root_cause"},
    {"step": 5, "agent": "contract", "task": "freeze_acceptance_contract"},
    {"step": 6, "agent": "author", "task": "implement_per_contract (inhouse) or stand by for rebuttal (external)"},
    {"step": 7, "agent": "tester", "task": "write_blind_adversarial_tests"},
    {"step": 8, "agent": "codenotary_leader", "task": "run_deterministic_gates_test_mutation"},
    {"step": 9, "agent": "author", "task": "rebut_mutation_survivors"},
    {"step": 10, "agent": "convention", "task": "run_and_interpret_convention_gate"},
    {"step": 11, "agent": "gatekeeper", "task": "final_verdict_summary"},
    {"step": 12, "agent": "release", "task": "deploy_if_notarized_or_rollback"},
    {"step": 13, "agent": "postmortem", "task": "distill_skill_and_seal_evidence"},
    {"step": 14, "agent": "codenotary_leader", "task": "compose_notary_report"}
  ],
  "blind_isolation": {
    "author_sees": ["frozen contract", "target source", "diagnosis"],
    "tester_sees": ["frozen contract", "baseline public tests"],
    "enforcement": "tool-contract level: no gateway tool exposes tester artifacts to author or author artifacts to tester"
  },
  "risk_policy": {
    "green_path": "all three gates (TEST_PASS, MUTATION, CONVENTION) green -> NOTARIZED -> human-approved deploy -> RELEASED",
    "red_path": "any red verdict -> REJECTED, evidence sealed for audit",
    "yellow_path": "any yellow verdict -> ESCALATED, resolve via notary_flow.resolve_human only"
  }
}
