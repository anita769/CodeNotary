# 在运行机器上可复制为 `.agentteams.env`，用于记录本次 demo 的关键配置。
#
# demo runner 不会自动读取这个文件；它只是给人看的配置清单。
# 注意：不要把任何真实 API Key 写入本文件或随代码包提交。

AT_ELEMENT_WEB_URL=http://127.0.0.1:18088
AT_MANAGER_ROOM=manager
AT_TASK_ROOM=<Team room for codenotary>
AT_TEAM_LEADER=codenotary-leader
AT_TEAM_NAME=codenotary
NOTARY_TOOL_BASE_URL=http://<TOOL_HOST_REACHABLE_BY_WORKER>:18090
