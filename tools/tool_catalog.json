{
  "transport": "http-notary-tool-gateway",
  "base_url": "http://<TOOL_HOST_REACHABLE_BY_WORKER>:18090",
  "call_pattern": "POST /tools/{scenario_id}/{tool_name}.{function_name}",
  "tools": [
    {
      "name": "notary_change",
      "kind": "deterministic-gateway",
      "functions": ["get_issue", "get_submitted_change"],
      "future_mcp_mapping": "change_intake.read"
    },
    {
      "name": "notary_repo",
      "kind": "deterministic-gateway",
      "functions": ["get_source", "get_baseline_tests"],
      "future_mcp_mapping": "repo.readonly_read"
    },
    {
      "name": "notary_sentinel",
      "kind": "deterministic-gateway",
      "functions": ["scan"],
      "future_mcp_mapping": "security.quarantine_scan"
    },
    {
      "name": "notary_flow",
      "kind": "deterministic-gateway (state machine)",
      "functions": ["triage", "diagnosis", "reproduce", "resolve_human"],
      "future_mcp_mapping": "pipeline.lifecycle"
    },
    {
      "name": "notary_contract",
      "kind": "deterministic-gateway (sha256 freeze)",
      "functions": ["freeze"],
      "future_mcp_mapping": "contract.freeze"
    },
    {
      "name": "notary_author",
      "kind": "deterministic-gateway (blind partition: no tester artifacts)",
      "functions": ["get_context", "submit_implementation"],
      "future_mcp_mapping": "workspace.author_partition"
    },
    {
      "name": "notary_tester",
      "kind": "deterministic-gateway (blind partition: no author artifacts)",
      "functions": ["get_context", "submit_tests"],
      "future_mcp_mapping": "workspace.tester_partition"
    },
    {
      "name": "notary_gate",
      "kind": "deterministic-gateway (live unittest + mutation runs)",
      "functions": ["run_test_gate", "run_mutation_gate", "get_survivors", "finalize_mutation", "run_convention_gate"],
      "future_mcp_mapping": "quality.gates"
    },
    {
      "name": "notary_rebuttal",
      "kind": "deterministic-gateway (adversarial loop protocol)",
      "functions": ["submit"],
      "future_mcp_mapping": "quality.rebuttal"
    },
    {
      "name": "notary_verdicts",
      "kind": "deterministic-gateway",
      "functions": ["list"],
      "future_mcp_mapping": "verdict.read"
    },
    {
      "name": "notary_state",
      "kind": "deterministic-gateway (read-only state machine view)",
      "functions": ["get"],
      "future_mcp_mapping": "pipeline.state_read"
    },
    {
      "name": "notary_release",
      "kind": "deterministic-gateway (gated on NOTARIZED)",
      "functions": ["deploy", "rollback"],
      "future_mcp_mapping": "deploy.execute"
    },
    {
      "name": "notary_evidence",
      "kind": "deterministic-gateway (sha256 seal)",
      "functions": ["list", "seal"],
      "future_mcp_mapping": "evidence.seal"
    },
    {
      "name": "notary_skill",
      "kind": "deterministic-gateway (append-only registry)",
      "functions": ["register"],
      "future_mcp_mapping": "skill_registry.register"
    }
  ]
}
